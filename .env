# AI Session Vault — local environment defaults
# Copy this file to .env.local and override values there.
# This file is intentionally checked in with safe defaults only.

# API key used by both the Spring Boot app and the hook scripts.
# Change this in production! Set it in your shell: $env:VAULT_API_KEY = "your-real-key"
VAULT_API_KEY=vault-secret-key-2026

# PostgreSQL credentials
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/ai_session_vault
SPRING_DATASOURCE_USERNAME=vault_user
SPRING_DATASOURCE_PASSWORD=vault_password

# Gemini API key (optional, used for future embedding features)
GEMINI_API_KEY=
