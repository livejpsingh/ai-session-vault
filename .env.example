# Copy to .env and replace every placeholder with a unique secret.
POSTGRES_PASSWORD=replace-with-a-strong-database-password
VAULT_API_KEY=replace-with-a-long-random-api-key

# Activate local-rag (Ollama) or cloud-rag (OpenAI).
SPRING_PROFILES_ACTIVE=local-rag
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_TOKENIZER_VOCAB_PATH=/models/nomic-embed-text-v1.5/vocab.txt

# Required only for cloud-rag.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini
VAULT_RAG_EMBEDDING_DIMENSION=768
