      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "apiKey",
      "value": "{{VAULT_API_KEY}}",
      "type": "string"
    },
    {
      "key": "sessionId",
      "value": "75f5e9bd-2782-4d9b-a162-74a1c95e155f",
      "type": "string"
